{
  "name": "fragancia",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "NODE_OPTIONS=--disable-warning=DEP0205 ng build",
    "watch": "NODE_OPTIONS=--disable-warning=DEP0205 ng build --watch --configuration development",
    "test": "ng test",
    "prestart": "bun run prepare:assets",
    "prebuild": "bun run prepare:assets",
    "pretest": "bun run prepare:assets",
    "prepare:assets": "bun run scripts/generate-sitemap.ts && arena-to-prod --src src --src design",
    "audit:arena": "arena-to-prod --src src --src design --audit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve:static": "bunx http-server dist/fragancia/browser -p 4173 -c-1",
    "lint": "ng lint",
    "postbuild": "bun run scripts/emit-404.ts"
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.4",
    "@dravensoft/arena-angular": "10.0.0",
    "@phosphor-icons/web": "^2.1.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
